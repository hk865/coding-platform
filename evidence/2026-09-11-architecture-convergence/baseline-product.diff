-  if (!isRecord(d["authorizedTarget"]) || !isBasePin(d["authorizedTarget"]["fromPin"]) || !isString(d["authorizedTarget"]["candidateDigest"])) {
-    issues.push("decision.authorizedTarget");
-  }
