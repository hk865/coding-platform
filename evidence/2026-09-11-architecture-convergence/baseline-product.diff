-      },
-      contentDigest: digest,
-      materializedAt: this.deps.now(),
-    };
-
-    return { status: "materialized", candidate };
-  }
-}
-
-export function createBaselineEvolutionPort(deps: BaselineEvolutionPortDeps): BaselineEvolutionPortImpl {
