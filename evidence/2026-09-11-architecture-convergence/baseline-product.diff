-/** Canonical JSON equality (JCS) used for all exact pin/ref chain comparisons. */
-function canonicalJsonEqual(a: unknown, b: unknown): boolean {
-  return canonicalJson(a as JsonValue) === canonicalJson(b as JsonValue);
