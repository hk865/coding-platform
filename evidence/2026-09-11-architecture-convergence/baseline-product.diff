-    return {
-      projectId: row.projectId,
-      goalId: row.goalId,
-      taskId: row.taskId,
-      currentAnchor,
-      planRef: this.viewPlanRef(row, planSnapshot, currentAnchor),
-      planRevision: this.viewPlanRevision(row, planSnapshot, currentAnchor),
-      evidence,
-      effectiveEvidenceIds,
-      blockingEvidenceIds,
-      reduction,
