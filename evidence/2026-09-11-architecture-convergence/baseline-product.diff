-  const GRAY = 1;
-  const BLACK = 2;
-  const color = new Map<string, number>();
-  for (const edge of edges) {
-    if (!color.has(edge.from)) color.set(edge.from, WHITE);
-    if (!color.has(edge.to)) color.set(edge.to, WHITE);
