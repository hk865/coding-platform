-      ref: snapshot.ref,
-      revision: snapshot.revision,
-    }));
-    this.persistIdempotency(
-      key,
-      batch.fingerprint,
-      written.eventIds,
-      aggregateRevisions,
-      written.commitCursor,
-    );
-
-    return {
-      status: "committed",
-      replayed: false,
-      identity: batch.identity,
-      aggregateRevisions,
-      eventIds: written.eventIds,
-      commitCursor: written.commitCursor,
-    };
-  }
