+/** Human-created templates use the same immutable RoleSpec command path as built-ins. */
+function AgentTemplateEditor({ api, scope, afterWrite, busy }: {
+  api: Api; scope: { projectId: string; workspaceId: string } | null;
+  afterWrite: (tone: 'success' | 'warning', text: string) => Promise<void>; busy: string | null;
+}) {
+  const [roleId, setRoleId] = useState('');
+  const [revision, setRevision] = useState<number | string>(1);
+  const [label, setLabel] = useState('');
+  const [purpose, setPurpose] = useState('');
+  const [responsibility, setResponsibility] = useState<string[]>(['investigation']);
+  const [selectedTools, setSelectedTools] = useState<string[]>(['read']);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const save = async () => {
+    if (!scope) return;
+    setSaving(true); setError(null);
+    try {
+      const result = await api.governanceInstall(scope, { kind: 'RoleSpecRevision', source: {
+        roleId, revision: Number(revision), content: {
+          schemaVersion: 1, label, purpose, responsibility,
+          requiredMaterials: [{ kind: 'contract', reason: '读取任务目标、范围和交付约定' }],
+          optionalMaterials: [{ kind: 'history', reason: '按本任务授权复用历史材料' }],
+          permissions: { tools: selectedTools, writeScope: selectedTools.some(tool => tool === 'write' || tool === 'shell') ? 'workspace' : 'none' },
+          budget: { source: 'task-budget', scope: 'assigned-task' },
+          requiredOutputs: [{ kind: 'answer-with-sources', reason: '提交产物及来源，保留未解决事项' }],
+          exit: { success: '提交任务约定的产物，验收由任务协议决定', stop: '缺少材料、授权或无法继续时报告原因', handoff: '记录公开事实、来源、产物及下一步' },
+        },
+      } });
+      await afterWrite(result.status === 'committed' ? 'success' : 'warning', result.message);
+    } catch (cause) { setError(errorMessage(cause)); }
+    finally { setSaving(false); }
+  };
+  return <Paper withBorder p="sm"><Stack gap="xs">
+    <Text fw={600}>创建 Agent 模板</Text>
+    <Text size="xs" c="dimmed">安装保存一个版本；激活后可在角色矩阵中选择。实际工具和材料范围仍由任务授权决定。</Text>
+    {error ? <Alert color="red">{error}</Alert> : null}
+    <Group grow><TextInput label="模板标识" value={roleId} onChange={e => setRoleId(e.currentTarget.value)} />
+      <NumberInput label="模板版本" min={1} allowDecimal={false} value={revision} onChange={setRevision} />
+      <TextInput label="Agent 名称" value={label} onChange={e => setLabel(e.currentTarget.value)} /></Group>
+    <Textarea label="简介与职责" value={purpose} onChange={e => setPurpose(e.currentTarget.value)} autosize minRows={2} />
+    <MultiSelect label="职责视角" value={responsibility} onChange={setResponsibility} data={[
+      { value: 'human_decision_support', label: '决策支持' }, { value: 'fact_consolidation', label: '事实整理' },
+      { value: 'planning', label: '规划' }, { value: 'integration', label: '集成' }, { value: 'execution', label: '执行' },
+      { value: 'verification', label: '验证' }, { value: 'investigation', label: '调查' },
+    ]} />
+    <MultiSelect label="工具集合" value={selectedTools} onChange={setSelectedTools} data={[
+      { value: 'read', label: '读取材料' }, { value: 'write', label: '工作区写入' }, { value: 'shell', label: '运行命令' },
+    ]} />
+    <Button onClick={() => void save()} loading={saving} disabled={busy !== null || !scope || !roleId.trim() || !label.trim() || !purpose.trim() || responsibility.length === 0}>保存模板版本</Button>
+  </Stack></Paper>;
+}
