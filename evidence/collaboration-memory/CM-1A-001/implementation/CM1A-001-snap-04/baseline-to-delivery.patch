+    // 本轮订阅范围由路由页事务在第一批处理时固定（协议约束 1.4）。
+    domain: {
+      kind: "route_page",
+      sourceTopic: input.topic,
+      sourceCursor: input.cursor,
+      subscriptionPosition: null,
+      subscriptionScope: [],
+    },
