+    planRef: { ...intent.planRef },
+    instructionSource: {
+      kind: "predecessor_run_spec",
+      runRef: { ...value.predecessorRunRef },
+      digest: instructionDigestOf(predecessor.instruction),
+    },
+    roleBinding: { ...value.roleBinding },
