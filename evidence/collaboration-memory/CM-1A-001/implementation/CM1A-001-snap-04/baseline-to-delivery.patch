+export type RouteIntentPlannableCommit = {
+  events: unknown[];
+  snapshots: unknown[];
+  expectedVersions: { ref: unknown; revision: number }[];
+  identity: { projectId: string };
+  routeIntentPlans?: import("../../contracts/coordination.js").RouteIntentPlanV1[];
