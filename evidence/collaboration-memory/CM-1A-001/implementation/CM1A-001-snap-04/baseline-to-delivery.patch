+async function successorFacts(s: Scenario): Promise<{ attempts: number; runs: number; pending: number }> {
+  return {
+    attempts: await countEvents(s.h, "TaskClaimed") - 1,
+    runs: await countEvents(s.h, "RunStarted") - 1,
