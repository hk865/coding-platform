new file mode 100644
index 0000000..1ba1787
--- /dev/null
+++ b/src/core/work-graph/tasks/trusted-context.ts
@@ -0,0 +1,116 @@
+/**
+ * Shared trusted Host context binding and write-request isolation.
+ *
+ * `bindTrustedHostContext` is the ONE skeleton that binds the real Host scope,
+ * actor and cancellation signal; `isolateTrustedWrite` is the ONE skeleton that
+ * isolates a write input and its version pins from the caller. Both run
+ * synchronously before the first await, so nothing the caller does afterwards
+ * can change what is judged or committed.
+ */
+import type { CoreCallContext, MaterialReader } from '../../../contracts/core/call-context.js';
+import type { VersionPin, WorkspaceScope } from '../../../contracts/core/identity.js';
+import type { CoreError, CoreRejection } from '../../../contracts/core/results.js';
+import { isRecord, nonEmpty } from '../../../contracts/validation/common.js';
+import type { GraphWrite } from '../model/task-contracts.js';
+
+export type TrustedHostActor = { kind: 'human' | 'system'; id: string };
+export type TrustedHostContextResult =
+  | { ok: true; ctx: CoreCallContext; scope: WorkspaceScope; actor: TrustedHostActor; signal: AbortSignal }
+  | { ok: false; rejection: CoreRejection };
+
+function reject(code: CoreError, reason: string): CoreRejection {
+  return { status: 'rejected', code, reason };
+}
+function invalid(reason: string): CoreRejection { return reject('invalid', reason); }
+function forbidden(reason: string): CoreRejection { return reject('forbidden', reason); }
+
+function sameHostActor(left: unknown, right: unknown): boolean {
+  return isRecord(left) && isRecord(right) && left['kind'] === right['kind'] && left['id'] === right['id']
+    && (left['kind'] === 'human' || left['kind'] === 'system');
+}
+
+/** Bind the trusted Host scope and identity before the first await; the
+ * original AbortSignal is kept by reference so cancellation is never lost. */
+export function bindTrustedHostContext(
+  ctx: CoreCallContext, label: string, options?: { allowArraySignal?: boolean },
+): TrustedHostContextResult {
+  const raw = ctx as unknown as {
+    projectId?: unknown; workspaceId?: unknown; principal?: unknown; materialReader?: unknown; signal?: unknown;
+  } | null | undefined;
+  if (raw === null || raw === undefined) {
+    return { ok: false, rejection: invalid(`${label} requires a bound call context`) };
+  }
+  const projectId = raw.projectId;
+  const workspaceId = raw.workspaceId;
+  if (!nonEmpty(projectId) || !nonEmpty(workspaceId)) {
+    return { ok: false, rejection: forbidden(`${label} requires a bound project/workspace context`) };
+  }
+  const signal = raw.signal;
+  if (options?.allowArraySignal) {
+    if (typeof signal !== 'object' || signal === null
+      || typeof (signal as { aborted?: unknown }).aborted !== 'boolean'
+      || typeof (signal as { addEventListener?: unknown }).addEventListener !== 'function') {
+      return { ok: false, rejection: forbidden(`${label} requires the bound AbortSignal`) };
+    }
+  } else if (!isRecord(signal) || typeof signal['aborted'] !== 'boolean'
+    || typeof signal['addEventListener'] !== 'function') {
+    return { ok: false, rejection: forbidden(`${label} requires the bound AbortSignal`) };
+  }
+  let principal: unknown;
+  let materialReader: unknown;
+  try {
+    principal = structuredClone(raw.principal);
+    materialReader = structuredClone(raw.materialReader);
+  } catch {
+    return { ok: false, rejection: invalid('the call context identity cannot be isolated from the caller') };
+  }
+  if (!isRecord(principal) || principal['kind'] !== 'host') {
+    return { ok: false, rejection: forbidden(`${label} requires a trusted Host principal`) };
+  }
+  const actor = principal['actor'];
+  if (!isRecord(actor) || (actor['kind'] !== 'human' && actor['kind'] !== 'system') || !nonEmpty(actor['id'])) {
+    return { ok: false, rejection: forbidden(`${label} requires a trusted Host actor`) };
+  }
+  if (!isRecord(materialReader) || materialReader['kind'] !== 'host'
+    || materialReader['projectId'] !== projectId
+    || (materialReader['workspaceId'] !== undefined && materialReader['workspaceId'] !== workspaceId)
+    || !sameHostActor(materialReader['actor'], actor)) {
+    return { ok: false, rejection: forbidden('the material reader is not the same trusted Host scope') };
+  }
+  return {
+    ok: true,
+    ctx: { projectId, workspaceId, principal: principal as CoreCallContext['principal'],
+      materialReader: materialReader as MaterialReader, signal: signal as AbortSignal },
+    scope: { projectId, workspaceId },
+    actor: { kind: actor['kind'], id: actor['id'] },
+    signal: signal as AbortSignal,
+  };
+}
+
+/** Isolate the request input and its version pins from the caller before the
+ * first await, so later mutation of the caller's objects cannot change what is
+ * judged, fingerprinted or committed. */
+export function isolateTrustedWrite<T>(
+  request: GraphWrite<T>, label: string, cloneFailure: string,
+): { ok: true; input: T; requestId: string; expected: readonly VersionPin[] } | { ok: false; rejection: CoreRejection } {
+  const raw = request as unknown as { input?: unknown; meta?: unknown } | null | undefined;
+  if (raw === null || raw === undefined || !isRecord(raw.input)) {
+    return { ok: false, rejection: invalid(`${label} requires a request input object`) };
+  }
+  const meta = raw.meta;
+  if (!isRecord(meta) || !nonEmpty(meta['requestId'])) {
+    return { ok: false, rejection: invalid(`${label} requires meta.requestId`) };
+  }
+  if (!Array.isArray(meta['expected'])) {
+    return { ok: false, rejection: invalid('meta.expected must be an array of version pins') };
+  }
+  let input: T;
+  let expected: readonly VersionPin[];
+  try {
+    input = structuredClone(raw.input) as T;
+    expected = structuredClone(meta['expected']) as VersionPin[];
+  } catch {
+    return { ok: false, rejection: invalid(cloneFailure) };
+  }
+  return { ok: true, input, requestId: meta['requestId'], expected };
+}
