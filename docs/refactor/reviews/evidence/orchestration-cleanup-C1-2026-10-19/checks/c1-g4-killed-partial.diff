@@ -0,0 +1,28 @@
+/**
+ * The projection inputs of a Task from its directed canonical read
+ * (`plan-readers.ts` `readCanonicalTaskFacts`): the selected Run, the
+ * applicable Reduction, the selected Run's round-chain signal, and an
+ * unresolvable origin, which that read shows only as a `blocked` Task with
+ * neither Run nor Reduction, and the TaskRequeue covering the selected Run
+ * (P4). It does not answer null for a missing selected Run or Reduction: each
+ * caller keeps its own extra check for that.
+ */
+import type { RuntimeTask } from '../../../contracts/plan.js';
+import type { TaskPhaseFacts } from '../state/task-machine.js';
+import { sameRef } from './execution-entry-service.js';
+import type { CanonicalTaskFacts, CanonicalTaskState } from './plan-readers.js';
+
+export function taskPhaseFactsOf(task: RuntimeTask, state: CanonicalTaskState, read: CanonicalTaskFacts): TaskPhaseFacts {
+  const execution = state.execution;
+  const selectedRun = execution === null ? null
+    : (read.runsByTaskId.get(task.taskId) ?? []).find(run => sameRef(run.ref, execution)) ?? null;
+  const applicableReduction = state.reductionRevision === null ? null : read.reductionsByTaskId.get(task.taskId) ?? null;
+  return {
+    taskKind: task.taskKind,
+    applicableReduction,
+    selectedRun,
+    originUnresolvable: selectedRun === null && applicableReduction === null && state.effectivePhase === 'blocked',
+    round: read.roundsByTaskId.get(task.taskId) ?? { kind: 'none' },
+    coveringRequeue: state.requeueRef,
+  };
+}
