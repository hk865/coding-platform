{
  "angle": "judge synthesis: proposal-2 layering (sessions below tasks, session codecs stay in sessions) + proposal-1 evidence handling (completion stays in tasks) + proposal-3 model-request-codecs follows its only consumer",
  "submodules": [
    {
      "id": "model",
      "path": "model/",
      "dependencies": [],
      "responsibility": "跨子模块共享的端口/数据契约与少量纯工具（task-index 邻接、deriveSessionInputId）；无 I/O、无记录编码、无业务流程"
    },
    {
      "id": "state",
      "path": "state/",
      "dependencies": [],
      "responsibility": "任务 A 的纯状态机（transition* / 记录构造），只依赖 src/contracts；目录由任务 A 创建"
    },
    {
      "id": "persistence",
      "path": "persistence/",
      "dependencies": [
        "model"
      ],
      "responsibility": "Goal 创建编译与仓储，以及被多个子模块共读的记录/事件编解码（Goal、执行入口、执行历史、控制、Plan、证据）"
    },
    {
      "id": "configuration",
      "path": "configuration/",
      "dependencies": [
        "model",
        "persistence"
      ],
      "responsibility": "Project/Workspace/CompletionPolicy 引导、角色配置与角色记忆"
    },
    {
      "id": "materials",
      "path": "materials/",
      "dependencies": [
        "model",
        "persistence"
      ],
      "responsibility": "材料访问、授权、适用性；RunSnapshot/QueryRun/Grant 只读编码与材料权威读取"
    },
    {
      "id": "architecture",
      "path": "architecture/",
      "dependencies": [
        "model",
        "persistence"
      ],
      "responsibility": "架构目录 catalog、基线与架构差异"
    },
    {
      "id": "sessions",
      "path": "sessions/",
      "dependencies": [
        "model",
        "state",
        "persistence",
        "materials",
        "architecture"
      ],
      "responsibility": "Session 目录、生命周期、工作目标，以及 SessionRecord / SessionMessage 记录编码"
    },
    {
      "id": "queries",
      "path": "queries/",
      "dependencies": [
        "model",
        "state",
        "persistence",
        "materials",
        "sessions"
      ],
      "responsibility": "QueryJob/QueryRun 提交、执行、答复及其记录编码"
    },
    {
      "id": "tasks",
      "path": "tasks/",
      "dependencies": [
        "model",
        "state",
        "persistence",
        "materials",
        "sessions",
        "queries"
      ],
      "responsibility": "Plan（读/写/校验/采用）、领取、执行入口与历史、控制、模型调用、运行状态、Task/Goal 完成判定与证据覆盖折叠"
    },
    {
      "id": "evidence",
      "path": "evidence/",
      "dependencies": [
        "model",
        "state",
        "persistence",
        "architecture",
        "tasks"
      ],
      "responsibility": "验证轮次与证据写入服务、验证计划"
    },
    {
      "id": "communication",
      "path": "communication/",
      "dependencies": [
        "model",
        "state",
        "persistence",
        "materials",
        "sessions",
        "queries",
        "tasks"
      ],
      "responsibility": "Session 邮箱：投递、读取、回复"
    },
    {
      "id": "source-authority-ports",
      "path": "source-authority-ports.ts",
      "dependencies": [
        "materials"
      ],
      "responsibility": "对 Runtime/Workflow 公开的来源权威读取端口类型（单文件）"
    },
    {
      "id": "source-authority-reader",
      "path": "source-authority-reader.ts",
      "dependencies": [
        "source-authority-ports",
        "materials",
        "queries"
      ],
      "responsibility": "来源权威精确事实读取适配器（单文件）"
    }
  ],
