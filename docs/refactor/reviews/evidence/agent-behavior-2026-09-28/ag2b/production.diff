+    handle.messages.push(message);
+    if (handle.messages.length > MAX_PROJECTED_MESSAGES) {
+      const removed = handle.messages.shift();
+      if (removed !== undefined) handle.messageKeys.delete(canonicalOf(removed.ref) ?? '');
+    }
+  }
