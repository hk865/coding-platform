      "occurrence": 1,
      "action": "release_worker_feedback",
      "args": {
        "feedback": "Persisted filter is lost after reload.",
        "expected": "new-candidate-then-independent-verification"
      }
    },
    {
      "id": "MA-08-final-review",
      "after": {
        "type": "all-required-checks-passed"
      },
      "occurrence": 1,
      "action": "allow_contract_review",
      "args": {
        "expected": "Control-reduction-after-review-current-version"
      }
    }
  ]
