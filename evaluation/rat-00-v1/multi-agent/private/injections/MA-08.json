      "args": {
        "overlayRef": "private/near-miss/no-persistence",
        "baseOverlayRef": "private/oracles/filter",
        "label": "test-input-not-model-output"
      }
    },
    {
      "id": "MA-08-concurrent-claims",
      "after": {
        "type": "hidden-check-failed"
      },
      "occurrence": 1,
      "action": "submit_test_claims",
      "args": {
        "roles": [
          "writer",
          "reviewer"
        ],
        "result": "completed",
        "expected": "no-completion"
      }
    },
    {
      "id": "MA-08-repair",
      "after": {
